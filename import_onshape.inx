<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Import Onshape SVG</name>
  <id>us.chouser.laser.import_onshape</id>

  <effect needs-live-preview="false" needs-document="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="Chouser-Laser"/></effects-menu>
  </effect>
  <script><command reldir="extensions" interpreter="python">import_onshape.py</command></script>
</inkscape-extension>

