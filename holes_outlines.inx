<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Separate Holes and Outlines</name>
  <id>us.chouser.laser.holes_outlines</id>

  <effect needs-live-preview="false" needs-document="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="onshape2falcon"/></effects-menu>
  </effect>
  <script><command reldir="extensions" interpreter="python">holes_outlines.py</command></script>
</inkscape-extension>
