<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Kerf</name>
  <id>us.chouser.laser.kerf</id>

  <param
      name="outset_mm"
      type="float"
      min="0"
      max="10"
      gui-text="Kerf outset (mm):">
    0.09
  </param>

  <effect needs-live-preview="false" needs-document="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="Chouser-Laser"/></effects-menu>
  </effect>
  <script><command reldir="extensions" interpreter="python">kerf.py</command></script>
</inkscape-extension>


