<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Kerf</name>
  <id>us.chouser.laser.kerf</id>

  <param name="preset" type="optiongroup" appearance="combo" gui-text="Kerf outset:">
    <option value="0.09">0.09 mm</option>
    <option value="0.04">0.04 mm</option>
    <option value="custom">Custom (use the value below)</option>
  </param>

  <param
      name="custom_mm"
      type="float"
      precision="3"
      min="0"
      max="10"
      gui-text="Custom outset (mm):">
    0.09
  </param>

  <effect needs-live-preview="false" needs-document="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="Chouser-Laser"/></effects-menu>
  </effect>
  <script><command reldir="extensions" interpreter="python">kerf.py</command></script>
</inkscape-extension>


